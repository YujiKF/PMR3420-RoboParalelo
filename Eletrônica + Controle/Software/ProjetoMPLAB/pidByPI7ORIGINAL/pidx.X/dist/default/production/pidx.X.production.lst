  1069     0A30                     clear_ram0:	
  1070                           ;	Called with FSR containing the base address, and
  1071                           ;	W with the last address+1
  1072                           
  1073     0A30  0064               	clrwdt	;clear the watchdog before getting into this loop
  1074     0A31                     clrloop0:
  1075     0A31  0180               	clrf	0	;clear RAM location pointed to by FSR
  1076     0A32  0A84               	incf	4,f	;increment pointer
  1077     0A33  0604               	xorwf	4,w	;XOR with final address
  1078     0A34  1903               	btfsc	3,2	;have we reached the end yet?
  1079     0A35  3400               	retlw	0	;all done for this memory range, return
  1080     0A36  0604               	xorwf	4,w	;XOR again to restore value
  1081     0A37  2A31               	goto	clrloop0	;do the next byte
